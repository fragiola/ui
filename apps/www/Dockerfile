# syntax=docker/dockerfile:1.7
#
# Fragiola UI — docs site (apps/www).
#
# BUILD CONTEXT IS THE REPOSITORY ROOT, not apps/www: the app lives in a pnpm
# workspace and the lockfile, workspace manifest and pnpm store all sit at
# the root. In Coolify: Build Pack "Dockerfile", Base Directory "/",
# Dockerfile Location "/apps/www/Dockerfile", port 3000.
#
# Stages
#   deps    install the workspace with a frozen lockfile (cached layer —
#           only manifests are copied, so source edits do not bust it)
#   build   registry JSON + `next build` (output: standalone)
#   runner  node:alpine, non-root, only the traced standalone output
#
# Nothing here reads environment at build time: the site has no env-driven
# config. Runtime PORT/HOSTNAME are set below.

ARG NODE_VERSION=24
ARG PNPM_VERSION=11.23.0

# ─── base ─────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS base
ARG PNPM_VERSION
# libc6-compat: glibc shim for prebuilt native binaries (esbuild via tsx,
# Tailwind's oxide) on musl. pnpm is pinned to packageManager in package.json.
RUN apk add --no-cache libc6-compat \
    && npm install --global --no-fund --no-audit pnpm@${PNPM_VERSION}
ENV CI=true \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /repo

# ─── deps ─────────────────────────────────────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/www/package.json apps/www/
# `--filter www...` installs www and its workspace dependencies only; the
# root's devDependencies (Biome) are not needed to build. The store is a
# BuildKit cache mount, so repeated builds re-link instead of re-download.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter www... --store-dir /pnpm/store

# ─── build ────────────────────────────────────────────────────────────────────
FROM deps AS build
COPY . .
# `pnpm --filter www build` = registry JSON (public/r) + `next build`. The
# fumadocs `.source` directory is generated by the Next plugin during the
# build, so neither it nor public/r need to be in the context.
RUN pnpm --filter www build

# ─── runner ───────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs nextjs
# The standalone tree mirrors the workspace (outputFileTracingRoot is the
# repo root), so the server lives at apps/www/server.js and the traced
# node_modules at the root. Static assets and public/ are NOT part of the
# standalone output by design — they are copied next to it.
COPY --from=build --chown=nextjs:nodejs /repo/apps/www/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /repo/apps/www/.next/static ./apps/www/.next/static
COPY --from=build --chown=nextjs:nodejs /repo/apps/www/public ./apps/www/public
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget --quiet --spider http://127.0.0.1:3000/ || exit 1
CMD ["node", "apps/www/server.js"]
