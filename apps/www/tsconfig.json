{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "plugins": [{ "name": "next" }],
        "paths": {
            "#/*": ["../../packages/registry/registry/*"],
            "@/*": ["./*"]
        },
        "types": ["next"]
    },
    "include": ["**/*.ts", "**/*.tsx", "**/*.mdx", ".next/types/**/*.ts"],
    "exclude": ["node_modules", ".next", "dist"]
}
