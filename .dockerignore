# Build context for apps/www/Dockerfile (context = repository root).
# Everything the build regenerates or never reads stays out.

.git
.worktrees
.claude
.github

**/node_modules
**/.next
**/.turbo
**/dist
**/out
**/coverage
**/*.tsbuildinfo
**/.tmp-tailwind-test

# Generated by the build itself
apps/www/.source
apps/www/public/r

# Not inputs to the build
docs
**/tests
**/*.test.ts
**/*.md
!**/README.md
**/Dockerfile
.dockerignore

.env
.env.*
!.env.example
.DS_Store
